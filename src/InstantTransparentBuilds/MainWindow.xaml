<Window x:Class="InstantTransparentBuilds.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Instant Transparent Builds — sg0hann" Width="1030" Height="740"
 MinWidth="820" MinHeight="610" WindowStartupLocation="CenterScreen"
 Background="#0B0D12" Foreground="#F1F3FA" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#242A39"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#343B50"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="#161A25"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
  <Style TargetType="TextBlock" x:Key="Muted"><Setter Property="Foreground" Value="#98A2BC"/></Style>
 </Window.Resources>
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,25">
   <StackPanel>
    <TextBlock Text="INSTANT TRANSPARENT BUILDS" Foreground="#7B9CFF" FontSize="12" FontWeight="Bold" LetterSpacing="2"/>
    <TextBlock Text="Build appearance studio." FontSize="34" FontWeight="Bold" Margin="0,8,0,4"/>
    <TextBlock Text="CD Revive companion · preview-only · no game modifications" Foreground="#9AA4BC" FontSize="14"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
   <StackPanel>
    <TextBlock Text="BUILD LEVELS" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>
    <UniformGrid Columns="4">
     <Button Tag="0" Click="Level_Click" Background="#444C5E" Content="LV. 1  ·  SILVER"/>
     <Button Tag="1" Click="Level_Click" Background="#116C6F" Content="LV. 2  ·  CYAN"/>
     <Button Tag="2" Click="Level_Click" Background="#24499B" Content="LV. 3  ·  BLUE"/>
     <Button Tag="3" Click="Level_Click" Background="#803B99" Content="LV. 4  ·  PURPLE"/>
    </UniformGrid>
    <TextBlock Text="Opacity" Margin="2,9,0,3" Foreground="#98A2BC"/>
    <Slider x:Name="OpacitySlider" Minimum="15" Maximum="85" Value="43" TickFrequency="5" ValueChanged="OpacityChanged"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}">
    <StackPanel>
     <DockPanel Margin="0,0,0,18">
      <TextBlock Text="LIVE PREVIEW" FontWeight="Bold" FontSize="15"/>
      <TextBlock Text="NO ANIMATION" Foreground="#8FE8C5" FontSize="11" HorizontalAlignment="Right"/>
     </DockPanel>
     <Viewbox Stretch="Uniform" Height="260">
      <Canvas Width="420" Height="280" Background="#101827">
       <Polygon Points="73,76 250,42 357,105 174,148" Fill="#293A56" Stroke="#7193B7" StrokeThickness="3"/>
       <Polygon x:Name="BuildFace" Points="73,76 174,148 174,255 73,184" Fill="#8290A5" Opacity=".43" Stroke="#E5EDFF" StrokeThickness="4"/>
       <Polygon x:Name="BuildSide" Points="174,148 357,105 357,207 174,255" Fill="#8290A5" Opacity=".43" Stroke="#E5EDFF" StrokeThickness="4"/>
       <Line X1="73" Y1="130" X2="174" Y2="200" Stroke="#C8D6F0" StrokeThickness="2"/>
       <Line X1="174" Y1="202" X2="357" Y2="155" Stroke="#C8D6F0" StrokeThickness="2"/>
       <Line X1="121" Y1="111" X2="121" Y2="218" Stroke="#C8D6F0" StrokeThickness="2"/>
       <Line X1="260" Y1="127" X2="260" Y2="234" Stroke="#C8D6F0" StrokeThickness="2"/>
      </Canvas>
     </Viewbox>
     <TextBlock x:Name="PreviewLabel" Text="Lv.1 · Transparent silver · 43% opacity" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,8"/>
     <TextBlock TextWrapping="Wrap" Foreground="#9AA4BC" Text="Concept preview only. Buttons and opacity do not alter the running game or its assets."/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="TOOLS" FontWeight="Bold" FontSize="15" Margin="0,0,0,17"/>
     <Button Content="Choose CD Revive folder" Click="ChooseFolder_Click"/>
     <TextBlock x:Name="GamePathLabel" Foreground="#98A2BC" TextWrapping="Wrap" Text="No game folder selected" Margin="1,0,0,16"/>
     <Button Content="Open game folder" Click="OpenFolder_Click"/>
     <Button Content="Back up selected file" Click="Backup_Click"/>
     <Button Content="Restore from backup" Click="Restore_Click"/>
     <Button Content="Check for app updates" Click="Update_Click"/>
     <TextBlock x:Name="StatusLabel" Text="Ready · v0.1.0" Foreground="#8FE8C5" TextWrapping="Wrap" Margin="0,13,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Foreground="#707B93" Margin="0,17,0,0" Text="sg0hann  /  no-texture-builds     •     Game files are never patched     •     No Defender or anti-cheat bypass"/>
 </Grid>
</Window>
